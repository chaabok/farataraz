{
  "reportName": "PaymentNotificationA4",
  "title": "PaymentNotificationA4",
  "category": "UserReports",
  "input": {},
  "script": "SELECT pn.\"PaymentNotificationID\" as \"paymentNotificationID\", pn.\"DocumentNumber\" as \"documentNumber\", pn.\"DocumentDate\" as \"documentDate\", COALESCE(pn.\"Description\", '') AS \"headDescription\", (SELECT COALESCE(SUM(pc.\"Amount\"), 0) FROM \"Rap\".\"PaymentCash\" pc WHERE pc.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") + (SELECT COALESCE(SUM(pch2.\"Amount\"), 0) FROM \"Rap\".\"PaymentCheque\" pch2 WHERE pch2.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") + (SELECT COALESCE(SUM(pwd.\"Amount\"), 0) FROM \"Rap\".\"PaymentWithdrawal\" pwd WHERE pwd.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") as \"totalAmount\", 0 as \"discountAmount\", (SELECT COALESCE(SUM(pc.\"Amount\"), 0) FROM \"Rap\".\"PaymentCash\" pc WHERE pc.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") + (SELECT COALESCE(SUM(pch2.\"Amount\"), 0) FROM \"Rap\".\"PaymentCheque\" pch2 WHERE pch2.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") + (SELECT COALESCE(SUM(pwd.\"Amount\"), 0) FROM \"Rap\".\"PaymentWithdrawal\" pwd WHERE pwd.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\") as \"netAmount\", coalesce(p.\"FirstName\", '') || ' ' || coalesce(p.\"LastName\", '') AS \"partyName\", coalesce(sub.\"chequeNumber\", '') as \"chequeNumber\", coalesce(sub.\"dueDate\", '') as \"dueDate\", coalesce(sub.\"bankInfo\", '') as \"bankInfo\", coalesce(sub.\"duration\", '') as \"duration\", coalesce(sub.\"isGuarantee\", '') as \"isGuarantee\", coalesce(sub.\"amount\", 0) as \"amount\", COALESCE((ROW_NUMBER() OVER(ORDER BY sub.\"tabOrder\", sub.\"detailId\")), 1) as \"rowNum\", COALESCE((SELECT c2.\"Title\" FROM \"Rap\".\"PaymentCash\" pc2 LEFT JOIN \"Rap\".\"Cashes\" c2 ON c2.\"CashID\" = pc2.\"CashRef\" WHERE pc2.\"PaymentNotificationRef\" = pn.\"PaymentNotificationID\" LIMIT 1), '') as \"cashName\", COALESCE(bs.\"Title\", 'تست') as \"companyTitle\" FROM \"Rap\".\"PaymentNotifications\" pn LEFT JOIN \"Gnr\".\"Parties\" p ON p.\"PartyID\" = pn.\"PartyRef\" LEFT JOIN \"Gnr\".\"BusinessStructure\" bs ON bs.\"BusinessStructureID\" = pn.\"CompanyRef\" LEFT JOIN (SELECT pc.\"PaymentNotificationRef\" as \"parentRef\", 1 as \"tabOrder\", pc.\"PaymentCashID\" as \"detailId\", 'نقدی' as \"chequeNumber\", '' as \"dueDate\", coalesce(c.\"Title\", '') as \"bankInfo\", '---' as \"duration\", '---' as \"isGuarantee\", coalesce(pc.\"Amount\", 0) as \"amount\" FROM \"Rap\".\"PaymentCash\" pc LEFT JOIN \"Rap\".\"Cashes\" c ON c.\"CashID\" = pc.\"CashRef\" UNION ALL SELECT pch.\"PaymentNotificationRef\" as \"parentRef\", 2 as \"tabOrder\", pch.\"PaymentChequeID\" as \"detailId\", coalesce(pch.\"ChequeNumber\", '') as \"chequeNumber\", '' as \"dueDate\", ltrim(coalesce(b.\"Title\", '') || ' ' || coalesce(bb.\"Title\", '') || ' ' || coalesce(ba.\"AccountNumber\", '')) as \"bankInfo\", 'روز' as \"duration\", '---' as \"isGuarantee\", coalesce(pch.\"Amount\", 0) as \"amount\" FROM \"Rap\".\"PaymentCheque\" pch LEFT JOIN \"Rap\".\"BankAccounts\" ba ON ba.\"BankAccountID\" = pch.\"BankAccountRef\" LEFT JOIN \"Rap\".\"BankBranchs\" bb ON bb.\"BankBranchID\" = ba.\"BankBranchRef\" LEFT JOIN \"Rap\".\"Banks\" b ON b.\"BankID\" = bb.\"BankID\" UNION ALL SELECT pwd.\"PaymentNotificationRef\" as \"parentRef\", 3 as \"tabOrder\", pwd.\"PaymentWithdrawalID\" as \"detailId\", coalesce(pwd.\"TrackingNumber\", 'برداشت') as \"chequeNumber\", '' as \"dueDate\", ltrim(coalesce(b.\"Title\", '') || ' ' || coalesce(bb.\"Title\", '') || ' ' || coalesce(ba.\"AccountNumber\", '')) as \"bankInfo\", 'برداشت' as \"duration\", '---' as \"isGuarantee\", coalesce(pwd.\"Amount\", 0) as \"amount\" FROM \"Rap\".\"PaymentWithdrawal\" pwd LEFT JOIN \"Rap\".\"BankAccounts\" ba ON ba.\"BankAccountID\" = pwd.\"BankAccountRef\" LEFT JOIN \"Rap\".\"BankBranchs\" bb ON bb.\"BankBranchID\" = ba.\"BankBranchRef\" LEFT JOIN \"Rap\".\"Banks\" b ON b.\"BankID\" = bb.\"BankID\") sub ON sub.\"parentRef\" = pn.\"PaymentNotificationID\" WHERE CAST(@id AS VARCHAR) <> '' AND pn.\"PaymentNotificationID\" = CAST(@id AS bigint)",
