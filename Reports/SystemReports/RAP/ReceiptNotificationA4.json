{
  "reportName": "ReceiptNotificationA4",
  "title": "ReceiptNotificationA4",
  "category": "UserReports",
  "input": {},
  "script": "SELECT pn.\"ReceiptNotificationID\" as \"paymentNotificationID\", pn.\"DocumentNumber\" as \"documentNumber\", pn.\"DocumentDate\" as \"documentDate\", COALESCE(pn.\"Description\", '') AS \"headDescription\", (SELECT COALESCE(SUM(pc.\"Amount\"), 0) FROM \"Rap\".\"ReceiptCash\" pc WHERE pc.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\") + (SELECT COALESCE(SUM(pch2.\"Amount\"), 0) FROM \"Rap\".\"ReceiptCheque\" pch2 WHERE pch2.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\") as \"totalAmount\", 0 as \"discountAmount\", (SELECT COALESCE(SUM(pc.\"Amount\"), 0) FROM \"Rap\".\"ReceiptCash\" pc WHERE pc.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\") + (SELECT COALESCE(SUM(pch2.\"Amount\"), 0) FROM \"Rap\".\"ReceiptCheque\" pch2 WHERE pch2.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\") as \"netAmount\", coalesce(p.\"FirstName\", '') || ' ' || coalesce(p.\"LastName\", '') AS \"partyName\", coalesce(c.\"Title\", '') AS \"cashName\", coalesce(pch.\"ChequeNumber\", '') as \"chequeNumber\", '' as \"dueDate\", ltrim(coalesce(b.\"Title\", '') || ' ' || coalesce(pch.\"BranchName\", '') || ' ' || coalesce(pch.\"AccountNumber\", '')) as \"bankInfo\", 'روز' as \"duration\", '---' as \"isGuarantee\", coalesce(pch.\"Amount\", 0) as \"amount\", COALESCE((ROW_NUMBER() OVER(ORDER BY pch.\"ReceiptChequeID\")), 1) as \"rowNum\", COALESCE(bs.\"Title\", 'تست') as \"companyTitle\" FROM \"Rap\".\"ReceiptNotifications\" pn LEFT JOIN \"Gnr\".\"Parties\" p ON p.\"PartyID\" = pn.\"PartyRef\" LEFT JOIN \"Gnr\".\"BusinessStructure\" bs ON bs.\"BusinessStructureID\" = pn.\"CompanyRef\" LEFT JOIN \"Rap\".\"ReceiptCash\" pca ON pca.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\" LEFT JOIN \"Rap\".\"Cashes\" c ON c.\"CashID\" = pca.\"CashRef\" LEFT JOIN \"Rap\".\"ReceiptCheque\" pch ON pch.\"ReceiptNotificationRef\" = pn.\"ReceiptNotificationID\" LEFT JOIN \"Rap\".\"Banks\" b ON b.\"BankID\" = pch.\"BankRef\" WHERE CAST(@id AS VARCHAR) <> '' AND pn.\"ReceiptNotificationID\" = CAST(@id AS bigint)",
