# Parsa ERP — Environment template (Task 44)
# Copy to erp.env and fill real values. DO NOT commit the real erp.env (contains secrets).
DATABASE_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/parsaDb
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME
DB_DATABASE=parsaDb
BACKEND_PORT=3005
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_HEX
NODE_ENV=development

# Data-safety: schema is managed manually; no auto DDL
DB_SYNCHRONIZE=false
BOOTSTRAP_DDL=false

FRONTEND_PUBLIC_DIR=/home/z/my-project/public
FRONTEND_ROOT=/home/z/my-project

# Ed25519 license verification — public key only (private key kept OFF-box)
LICENSE_PUBLIC_KEY=<paste base64 public key from backend/keys/license_public_key.pem>
